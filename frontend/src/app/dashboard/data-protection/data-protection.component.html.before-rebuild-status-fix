      </div>
    </div>

    <!-- LIVE POSTURE -->

    <div class="grid gap-3 p-3 sm:p-4 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="rounded-[14px] border border-slate-200 bg-slate-50 p-4">
        <div class="flex items-start justify-between gap-3.5">
          <div>
            <p class="text-[9px] font-black uppercase tracking-[0.16em] text-slate-400">
              Live Protection State
            </p>

            <div class="mt-2.5 flex items-center gap-2.5">
              <span
                class="h-2.5 w-2.5 rounded-full"
                [ngClass]="{
                  'bg-emerald-500': liveState === 'LIVE',
                  'bg-amber-500': liveState === 'DEGRADED',
                  'bg-rose-500': liveState === 'ERROR',
                }"
              ></span>

              <span class="text-lg font-black text-slate-950">
                {{ liveStateLabel }}
              </span>
            </div>
          </div>

          <span
            class="rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[8px] font-black uppercase tracking-[0.12em] text-slate-500"
          >
            Authoritative
          </span>
        </div>

        <p class="mt-2 text-[11px] font-medium leading-4 text-slate-600">
          {{ liveStateReason }}
        </p>
      </div>

      <!-- REFRESH -->

      <div class="rounded-[14px] border border-slate-200 bg-white p-4">
        <p class="text-[9px] font-black uppercase tracking-[0.16em] text-slate-400">
          Telemetry Refresh
        </p>

        <div class="mt-2.5 flex items-end justify-between gap-3">
          <div>
            <p class="text-xs font-semibold text-slate-500">Last refresh</p>

            <p class="mt-1 text-xs font-black text-slate-950">
              {{ lastRefreshAt ? (lastRefreshAt | date: 'medium') : 'Waiting' }}
            </p>
          </div>

          <span
            class="rounded-full bg-slate-100 px-2.5 py-1 text-[8px] font-black uppercase tracking-[0.12em] text-slate-500"
          >
            {{ liveRefreshIntervalMs / 1000 }}s cycle
          </span>
        </div>

        <div class="mt-2 h-1 overflow-hidden rounded-full bg-slate-100">
          <div class="h-full w-full rounded-full bg-blue-500/70"></div>
        </div>

        <p class="mt-1.5 text-[8px] font-semibold text-slate-400">
          Automatic live refresh is active.
        </p>
      </div>
    </div>

    <!-- MONITORING SIGNALS -->

    <div class="border-t border-slate-100 p-3 sm:p-4">
      <div class="mb-2">
        <p class="text-[9px] font-black uppercase tracking-[0.16em] text-slate-400">
          Guardian Signals
        </p>

        <h3 class="mt-1 text-sm font-black text-slate-950">Current monitoring boundary</h3>
      </div>

      <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Recovery telemetry -->

        <div class="rounded-[12px] border border-emerald-200 bg-emerald-50 p-3">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>

            <span class="text-xs font-black text-slate-950"> Recovery Telemetry </span>
          </div>

          <p class="mt-2 text-[10px] font-medium leading-4 text-slate-600">
            Existing recovery service is the authoritative source for current protection state.
          </p>
        </div>

        <!-- Warnings -->

        <div
          class="rounded-[12px] border p-3"
          [ngClass]="
            activeWarnings > 0 ? 'border-amber-200 bg-amber-50' : 'border-slate-200 bg-slate-50'
          "
        >
          <div class="flex items-center gap-2">
            <span
              class="h-2 w-2 rounded-full"
              [ngClass]="activeWarnings > 0 ? 'bg-amber-500' : 'bg-slate-400'"
            ></span>

            <span class="text-xs font-black text-slate-950"> Active Warnings </span>
          </div>

          <p class="mt-2 text-[10px] font-medium leading-4 text-slate-600">
            {{ activeWarnings }} active warning{{ activeWarnings === 1 ? '' : 's' }}.
          </p>
        </div>

        <!-- Guardian -->

        <div class="rounded-[12px] border border-slate-200 bg-slate-50 p-3">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-slate-400"></span>

            <span class="text-xs font-black text-slate-950"> Guardian Supervisor </span>
          </div>

          <p class="mt-2 text-[10px] font-medium leading-4 text-slate-600">
            Guardian monitored. Authoritative supervisor event telemetry is not exposed yet.
          </p>
        </div>
      </div>
    </div>

    <!-- LOADING / ERROR -->

    <div *ngIf="loading || errorMessage" class="border-t border-slate-100 p-3 sm:p-4">
      <!-- Loading -->

      <div *ngIf="loading" class="rounded-[12px] border border-blue-200 bg-blue-50 p-3">
        <div class="flex items-center gap-3">
          <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-blue-500"></span>

          <div>
            <p class="text-xs font-black text-slate-950">Refreshing protection telemetry</p>

            <p class="mt-1 text-[10px] font-medium text-slate-500">
              Waiting for the authoritative recovery response.
            </p>
          </div>
        </div>
      </div>

      <!-- Error -->

      <div *ngIf="errorMessage" class="rounded-[12px] border border-rose-200 bg-rose-50 p-3">
        <div class="flex items-start gap-3">
          <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-rose-500"></span>

          <div>
            <p class="text-xs font-black text-slate-950">Protection telemetry error</p>

            <p class="mt-1 text-[10px] font-medium leading-5 text-slate-600">
              {{ errorMessage }}
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- TELEMETRY BOUNDARY -->

    <div class="border-t border-slate-100 bg-slate-50/70 p-3 sm:p-4">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-[9px] font-black uppercase tracking-[0.16em] text-slate-400">
            Telemetry Boundary
          </p>

          <p class="mt-1 text-xs font-semibold text-slate-600">
            Heartbeat, crash counters, incident history and current operation telemetry are not
            exposed by this component yet.
          </p>
        </div>

        <span
          class="inline-flex w-fit items-center rounded-full border border-slate-200 bg-white px-3 py-1.5 text-[8px] font-black uppercase tracking-[0.12em] text-slate-500"
        >
          No fabricated telemetry
        </span>
      </div>
    </div>
  </div>
</section>

<!-- 757.7P CONTINUOUS GUARDIAN END -->
