                  class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-[8px] font-black uppercase tracking-wider text-slate-800 disabled:cursor-not-allowed disabled:opacity-50"
                  [disabled]="failoverBusy"
                  (click)="promoteAutomaticFailover()"
