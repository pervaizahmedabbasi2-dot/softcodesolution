                </div>
              </div>
            </article>
          </div>
        </div>
      </div>

      <!-- TELEMETRY BOUNDARY -->

      <div class="border-t border-slate-100 px-4 py-4 sm:px-6">
        <div class="rounded-2xl border border-blue-100 bg-blue-50/60 p-4">
          <p class="text-[8px] font-black uppercase tracking-[0.16em] text-blue-700">
            Timeline Boundary
          </p>

          <p class="mt-1 text-[10px] font-semibold leading-5 text-slate-600">
            Recovery-point history and available authoritative recovery events are displayed from
            the existing recovery service.
          </p>
        </div>
      </div>
    </div>
  </section>
</div>

