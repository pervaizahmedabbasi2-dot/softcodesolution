            [disabled]="operationBusy !== null"
            (click)="createRecoveryPoint()"
          >
            {{ operationBusy === 'create' ? 'Creating…' : 'Create Recovery Point' }}
          </button>

          <button
            type="button"
            class="rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-[9px] font-black uppercase tracking-wider text-emerald-700 disabled:cursor-not-allowed disabled:opacity-50"
            [disabled]="!latestBackup?.id || operationBusy !== null"
            (click)="verifyRecoveryPoint()"
          >
            {{ operationBusy === 'verify' ? 'Verifying…' : 'Verify Latest' }}
          </button>

          <button
            type="button"
            class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-[9px] font-black uppercase tracking-wider text-amber-700 disabled:cursor-not-allowed disabled:opacity-50"
            [disabled]="!latestBackup?.id || operationBusy !== null"
            (click)="restoreRecoveryPoint()"
          >
            {{ operationBusy === 'restore' ? 'Restoring…' : 'Restore Latest' }}
          </button>
