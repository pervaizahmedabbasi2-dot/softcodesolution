                {{ failoverStatus?.state || 'UNKNOWN' }}
              </span>
            </div>

            <h4 class="mt-4 text-sm font-black text-slate-950">Automatic Failover</h4>

            <p class="mt-1 text-[9px] font-semibold leading-4 text-slate-500">
