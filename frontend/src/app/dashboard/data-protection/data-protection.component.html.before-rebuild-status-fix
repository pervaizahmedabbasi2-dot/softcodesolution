<div class="min-h-full w-full bg-slate-50 p-4 sm:p-5 lg:p-6">
  <!-- 757.7B PREMIUM ENTERPRISE HERO -->

  <section
    id="protection-overview"
    class="relative overflow-hidden rounded-[28px] border border-slate-800 bg-slate-950 text-white shadow-[0_24px_70px_rgba(15,23,42,0.18)]"
  >
    <!-- subtle background glow -->
    <div
      class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-blue-500/10 blur-3xl"
    ></div>

    <div
      class="pointer-events-none absolute -bottom-32 left-1/3 h-72 w-72 rounded-full bg-emerald-500/5 blur-3xl"
    ></div>

    <div class="relative p-5 sm:p-7 lg:p-8">
      <!-- TOP META -->

      <div class="flex flex-col gap-5 xl:flex-row xl:items-start xl:justify-between">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <span
              class="inline-flex items-center rounded-full border border-blue-400/20 bg-blue-400/10 px-2.5 py-1 text-[9px] font-black uppercase tracking-[0.2em] text-blue-300"
            >
              DATA PROTECTION / RECOVERY CENTER
            </span>

            <span
              class="inline-flex items-center gap-1.5 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-2.5 py-1 text-[9px] font-black uppercase tracking-[0.16em] text-emerald-300"
            >
              <span
                class="h-1.5 w-1.5 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.8)]"
              ></span>
              LIVE
            </span>
          </div>

          <h1
            class="mt-4 max-w-3xl text-3xl font-black tracking-[-0.035em] text-white sm:text-4xl lg:text-5xl"
          >
            Protection &amp; Recovery
          </h1>

          <p class="mt-3 max-w-2xl text-sm font-medium leading-6 text-slate-400 sm:text-[15px]">
            Autonomous protection control plane for continuous recovery, integrity verification and
            resilient system operation.
          </p>
        </div>

        <!-- REFRESH -->

        <button
          type="button"
          (click)="refresh()"
          [disabled]="loading"
          class="inline-flex shrink-0 items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white px-4 py-3 text-[10px] font-black uppercase tracking-[0.16em] text-slate-950 shadow-lg transition hover:-translate-y-0.5 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-50"
        >
          <svg
            class="h-4 w-4"
            [class.animate-spin]="loading"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 4v5h5M20 20v-5h-5M5.5 9A7 7 0 0 1 18 6.5L20 9M18.5 15A7 7 0 0 1 6 17.5L4 15"
            />
          </svg>

          {{ loading ? 'Refreshing...' : 'Refresh State' }}
        </button>
      </div>

      <!-- CONTROL SUMMARY -->

      <div class="mt-8 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <!-- PROTECTION SCORE -->

        <div class="rounded-2xl border border-white/10 bg-white/[0.045] p-4 backdrop-blur-sm">
          <div class="flex items-center justify-between">
            <span class="text-[9px] font-black uppercase tracking-[0.18em] text-slate-500">
              Protection Score
            </span>

            <span
              class="rounded-lg border border-emerald-400/10 bg-emerald-400/10 px-2 py-1 text-[8px] font-black uppercase tracking-wider text-emerald-300"
            >
              Verified State
            </span>
          </div>

          <div class="mt-3 flex items-end gap-1">
            <span class="text-3xl font-black tracking-tight text-white">
              {{ protectionScore }}
            </span>

            <span class="mb-1 text-sm font-black text-slate-500"> % </span>
          </div>

          <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-white/10">
            <div
              class="h-full rounded-full bg-emerald-400 transition-all duration-500"
              [style.width.%]="protectionScore"
            ></div>
          </div>
        </div>

        <!-- PROTECTION MODEL -->

        <div class="rounded-2xl border border-white/10 bg-white/[0.045] p-4 backdrop-blur-sm">
          <span class="text-[9px] font-black uppercase tracking-[0.18em] text-slate-500">
            Protection Model
          </span>

          <div class="mt-3 flex items-center gap-3">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-xl border border-blue-400/20 bg-blue-400/10 text-blue-300"
            >
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 3l7 3v5c0 4.5-2.8 7.8-7 10-4.2-2.2-7-5.5-7-10V6l7-3z"
                />
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" />
              </svg>
            </div>

            <div>
              <p class="text-sm font-black text-white">Autonomous</p>

              <p class="mt-0.5 text-[10px] font-semibold text-slate-500">
                Continuous protection control
              </p>
            </div>
          </div>
        </div>

        <!-- RECOVERY MODEL -->

        <div class="rounded-2xl border border-white/10 bg-white/[0.045] p-4 backdrop-blur-sm">
          <span class="text-[9px] font-black uppercase tracking-[0.18em] text-slate-500">
            Recovery Model
          </span>

          <div class="mt-3 flex items-center gap-3">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-xl border border-violet-400/20 bg-violet-400/10 text-violet-300"
            >
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4 12a8 8 0 0113.7-5.7L20 9"
                />
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 4v5h-5" />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M20 12a8 8 0 01-13.7 5.7L4 15"
                />
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 20v-5h5" />
              </svg>
            </div>

            <div>
              <p class="text-sm font-black text-white">Self-Healing</p>

              <p class="mt-0.5 text-[10px] font-semibold text-slate-500">
                Restore · Verify · Rebuild
              </p>
            </div>
          </div>
        </div>

        <!-- SYSTEM STATE -->

        <div class="rounded-2xl border border-white/10 bg-white/[0.045] p-4 backdrop-blur-sm">
          <span class="text-[9px] font-black uppercase tracking-[0.18em] text-slate-500">
            System State
          </span>

          <div class="mt-3 flex items-center gap-3">
            <div
              class="relative flex h-10 w-10 items-center justify-center rounded-xl border border-emerald-400/20 bg-emerald-400/10"
            >
              <span class="absolute h-2.5 w-2.5 animate-ping rounded-full bg-emerald-400/50"></span>

              <span class="relative h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
            </div>

            <div>
              <p class="text-sm font-black text-emerald-300">Live</p>

              <p class="mt-0.5 text-[10px] font-semibold text-slate-500">
                Protection control plane active
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- CONTROL MESSAGE -->

      <div
        class="mt-4 flex flex-col gap-3 rounded-2xl border border-white/10 bg-black/20 px-4 py-3 sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="flex min-w-0 items-center gap-3">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white/5">
            <svg
              class="h-4 w-4 text-slate-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <circle cx="12" cy="12" r="9"></circle>
              <path stroke-linecap="round" d="M12 8v4l2.5 1.5"></path>
            </svg>
          </div>

          <div class="min-w-0">
            <p class="truncate text-[10px] font-black uppercase tracking-[0.14em] text-slate-300">
              Protection Control Plane
            </p>

            <p class="mt-0.5 text-[10px] font-semibold text-slate-500">
              Monitoring, protection and recovery management are centralized here.
            </p>
          </div>
        </div>

        <span class="shrink-0 text-[9px] font-black uppercase tracking-[0.16em] text-emerald-400">
          Continuous Monitoring
        </span>
      </div>
    </div>
  </section>

  <!-- 757.7UX COMPACT MANAGEMENT COMMAND CENTER -->

  <section id="protection-command-center" class="mt-5 scroll-mt-6">
    <div class="overflow-hidden rounded-[26px] border border-slate-200 bg-white shadow-sm">
      <!-- COMMAND HEADER -->

      <div class="border-b border-slate-100 bg-slate-50/80 px-4 py-4 sm:px-5">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-[9px] font-black uppercase tracking-[0.18em] text-slate-400">
              Protection Control Center
            </p>

            <h2 class="mt-1 text-base font-black tracking-tight text-slate-950 sm:text-lg">
              Management Console
            </h2>
          </div>

          <div
            class="inline-flex w-fit items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1.5"
          >
            <span
              class="h-1.5 w-1.5 rounded-full"
              [ngClass]="{
                'bg-emerald-500': liveState === 'LIVE',
                'bg-amber-500': liveState === 'DEGRADED',
                'bg-rose-500': liveState === 'ERROR',
              }"
            ></span>

            <span class="text-[9px] font-black uppercase tracking-[0.14em] text-slate-600">
              {{ liveStateLabel }}
            </span>
          </div>
        </div>
      </div>

      <!-- MANAGEMENT NAV -->

      <div class="border-b border-slate-100 p-2.5">
        <nav aria-label="Protection management" class="overflow-x-auto">
          <div class="grid min-w-[620px] grid-cols-5 gap-1">
            <a
              href="#protection-overview"
              class="group rounded-[15px] bg-slate-950 px-3 py-2.5 text-center transition hover:-translate-y-0.5"
            >
              <span class="block text-[9px] font-black uppercase tracking-[0.12em] text-white">
                Overview
              </span>
              <span class="mt-0.5 block text-[8px] font-semibold text-slate-400"> Control </span>
            </a>

            <a
              href="#protection-layers"
              class="group rounded-[15px] px-3 py-2.5 text-center transition hover:bg-slate-100"
            >
              <span class="block text-[9px] font-black uppercase tracking-[0.12em] text-slate-600">
                Protection
              </span>
              <span class="mt-0.5 block text-[8px] font-semibold text-slate-400"> 5 Layers </span>
            </a>

            <a
              href="#recovery-points"
              class="group rounded-[15px] px-3 py-2.5 text-center transition hover:bg-slate-100"
            >
              <span class="block text-[9px] font-black uppercase tracking-[0.12em] text-slate-600">
                Recovery
              </span>
              <span class="mt-0.5 block text-[8px] font-semibold text-slate-400"> Points </span>
            </a>

            <a
              href="#recovery-timeline"
              class="group rounded-[15px] px-3 py-2.5 text-center transition hover:bg-slate-100"
            >
              <span class="block text-[9px] font-black uppercase tracking-[0.12em] text-slate-600">
                Timeline
              </span>
              <span class="mt-0.5 block text-[8px] font-semibold text-slate-400"> History </span>
            </a>

            <a
              href="#audit-integrity"
              class="group rounded-[15px] px-3 py-2.5 text-center transition hover:bg-slate-100"
            >
              <span class="block text-[9px] font-black uppercase tracking-[0.12em] text-slate-600">
                Audit
              </span>
              <span class="mt-0.5 block text-[8px] font-semibold text-slate-400"> Integrity </span>
            </a>
          </div>
        </nav>
      </div>

      <!-- EXECUTIVE METRICS -->

      <div class="grid grid-cols-2 gap-2.5 p-3 sm:grid-cols-4">
        <a
          href="#protection-overview"
          class="rounded-[18px] border border-slate-200 bg-white p-3 transition hover:-translate-y-0.5 hover:shadow-sm"
        >
          <p class="text-[8px] font-black uppercase tracking-[0.13em] text-slate-400">Protection</p>

          <p class="mt-1 text-lg font-black text-slate-950">{{ protectionScore }}%</p>

          <p class="mt-0.5 text-[8px] font-semibold text-slate-400">Verified coverage</p>
        </a>

        <a
          href="#protection-layers"
          class="rounded-[18px] border border-slate-200 bg-white p-3 transition hover:-translate-y-0.5 hover:shadow-sm"
        >
          <p class="text-[8px] font-black uppercase tracking-[0.13em] text-slate-400">
            Architecture
          </p>

          <p class="mt-1 text-lg font-black text-slate-950">5</p>

          <p class="mt-0.5 text-[8px] font-semibold text-slate-400">Protection layers</p>
        </a>

        <a
          href="#recovery-points"
          class="rounded-[18px] border border-slate-200 bg-white p-3 transition hover:-translate-y-0.5 hover:shadow-sm"
        >
          <p class="text-[8px] font-black uppercase tracking-[0.13em] text-slate-400">Recovery</p>

          <p class="mt-1 text-lg font-black text-slate-950">
            {{ recoveryPoints.length }}
          </p>

          <p class="mt-0.5 text-[8px] font-semibold text-slate-400">Available points</p>
        </a>

        <a
          href="#guardian-monitoring"
          class="rounded-[18px] border border-slate-200 bg-white p-3 transition hover:-translate-y-0.5 hover:shadow-sm"
        >
          <p class="text-[8px] font-black uppercase tracking-[0.13em] text-slate-400">Guardian</p>

          <p class="mt-1 text-lg font-black text-slate-950">
            {{ activeWarnings }}
          </p>

          <p class="mt-0.5 text-[8px] font-semibold text-slate-400">Active warnings</p>
        </a>
      </div>

      <!-- MANAGEMENT DESTINATIONS -->

      <div class="grid gap-2.5 border-t border-slate-100 p-3 sm:grid-cols-2 lg:grid-cols-4">
        <a
          href="#protection-layers"
          class="group rounded-[20px] border border-slate-200 bg-slate-50/70 p-4 transition hover:-translate-y-0.5 hover:bg-white hover:shadow-sm"
        >
          <div class="flex items-center justify-between">
            <span
              class="flex h-8 w-8 items-center justify-center rounded-[12px] bg-emerald-100 text-emerald-700"
            >
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
            </span>

            <span class="text-xs text-slate-300 transition group-hover:text-slate-600"> → </span>
          </div>

          <p class="mt-3 text-xs font-black text-slate-950">Protection</p>

          <p class="mt-1 text-[9px] font-medium leading-4 text-slate-500">
            Manage all five protection layers and their verified states.
          </p>
        </a>

        <a
          href="#recovery-points"
          class="group rounded-[20px] border border-slate-200 bg-slate-50/70 p-4 transition hover:-translate-y-0.5 hover:bg-white hover:shadow-sm"
        >
          <div class="flex items-center justify-between">
            <span
              class="flex h-8 w-8 items-center justify-center rounded-[12px] bg-violet-100 text-violet-700"
            >
              <span class="h-2 w-2 rounded-full bg-violet-500"></span>
            </span>

            <span class="text-xs text-slate-300 transition group-hover:text-slate-600"> → </span>
          </div>

          <p class="mt-3 text-xs font-black text-slate-950">Recovery</p>

          <p class="mt-1 text-[9px] font-medium leading-4 text-slate-500">
            Manage available recovery points and verification state.
          </p>
        </a>

        <a
          href="#recovery-timeline"
          class="group rounded-[20px] border border-slate-200 bg-slate-50/70 p-4 transition hover:-translate-y-0.5 hover:bg-white hover:shadow-sm"
        >
          <div class="flex items-center justify-between">
            <span
              class="flex h-8 w-8 items-center justify-center rounded-[12px] bg-amber-100 text-amber-700"
            >
              <span class="h-2 w-2 rounded-full bg-amber-500"></span>
            </span>

            <span class="text-xs text-slate-300 transition group-hover:text-slate-600"> → </span>
          </div>

          <p class="mt-3 text-xs font-black text-slate-950">Timeline</p>

          <p class="mt-1 text-[9px] font-medium leading-4 text-slate-500">
            Review authoritative recovery history and available activity.
          </p>
        </a>

        <a
          href="#audit-integrity"
          class="group rounded-[20px] border border-slate-200 bg-slate-50/70 p-4 transition hover:-translate-y-0.5 hover:bg-white hover:shadow-sm"
        >
          <div class="flex items-center justify-between">
            <span
              class="flex h-8 w-8 items-center justify-center rounded-[12px] bg-rose-100 text-rose-700"
            >
              <span class="h-2 w-2 rounded-full bg-rose-500"></span>
            </span>

            <span class="text-xs text-slate-300 transition group-hover:text-slate-600"> → </span>
          </div>

          <p class="mt-3 text-xs font-black text-slate-950">Audit & Integrity</p>

          <p class="mt-1 text-[9px] font-medium leading-4 text-slate-500">
            Inspect hashes, verification and integrity evidence.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- 757.7UX COMPACT MANAGEMENT COMMAND CENTER END -->

  <!-- 757.7W PROTECTION MANAGEMENT VIEW -->

  <section id="protection-layers" class="mt-5 scroll-mt-6">
    <div class="overflow-hidden rounded-[26px] border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 bg-slate-50/70 px-5 py-4 sm:px-6">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.16em] text-slate-400">
              Protection Management
            </p>

            <h2 class="mt-1 text-base font-black tracking-tight text-slate-950">
              5-Layer Protection Control
            </h2>

            <p class="mt-1 text-xs font-medium leading-5 text-slate-500">
              Compact control surface for protection layers, integrity verification and detection
              state.
            </p>
          </div>

          <div
            class="inline-flex w-fit items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1.5"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>

            <span class="text-[9px] font-black uppercase tracking-[0.14em] text-slate-500">
              Live protection state
            </span>
          </div>
        </div>
      </div>

      <div class="grid gap-3 p-4 sm:grid-cols-2 lg:grid-cols-4">
        <!-- LAYER 1 -->
        <a
          href="#layer-1"
          class="group rounded-[20px] border border-slate-200 bg-white p-4 transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md"
        >
          <div class="flex items-start justify-between gap-3">
            <span
              class="flex h-8 w-8 items-center justify-center rounded-xl bg-slate-950 text-[10px] font-black text-white"
            >
              01
            </span>

            <span
              class="h-2 w-2 rounded-full"
              [ngClass]="{
                'bg-emerald-400': layers[0].status === 'Verified',
                'bg-amber-400':
                  layers[0].status === 'Waiting' ||
                  layers[0].status === 'Not verified' ||
                  layers[0].status === 'Degraded',
                'bg-rose-400': layers[0].status === 'Failed' || layers[0].status === 'Error',
                'bg-blue-400':
                  layers[0].status !== 'Verified' &&
                  layers[0].status !== 'Waiting' &&
                  layers[0].status !== 'Not verified' &&
                  layers[0].status !== 'Degraded' &&
                  layers[0].status !== 'Failed' &&
                  layers[0].status !== 'Error',
              }"
            ></span>
          </div>

          <p class="mt-4 text-[9px] font-black uppercase tracking-[0.14em] text-slate-400">
            Layer 1
          </p>

          <h3 class="mt-1 text-sm font-black text-slate-950">Core Recovery</h3>

          <p class="mt-1 text-[10px] font-medium leading-4 text-slate-500">
            PostgreSQL + SQLite recovery point
          </p>

          <div class="mt-3">
            <span
              class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[9px] font-black uppercase tracking-[0.12em] text-slate-600"
              [ngClass]="{
                'border-emerald-200 bg-emerald-50 text-emerald-700':
                  layers[0].status === 'Verified',
                'border-amber-200 bg-amber-50 text-amber-700':
                  layers[0].status === 'Waiting' ||
                  layers[0].status === 'Not verified' ||
                  layers[0].status === 'Degraded',
                'border-rose-200 bg-rose-50 text-rose-700':
                  layers[0].status === 'Failed' || layers[0].status === 'Error',
                'border-blue-200 bg-blue-50 text-blue-700':
                  layers[0].status !== 'Verified' &&
                  layers[0].status !== 'Waiting' &&
                  layers[0].status !== 'Not verified' &&
                  layers[0].status !== 'Degraded' &&
                  layers[0].status !== 'Failed' &&
                  layers[0].status !== 'Error',
              }"
            >
              {{ layers[0].status }}
            </span>
          </div>
          <span
            class="mt-3 inline-block text-[9px] font-black uppercase tracking-[0.12em] text-slate-400 transition group-hover:text-slate-950"
          >
            Open layer →
          </span>
        </a>

        <!-- LAYER 2 -->
        <a
          href="#layer-2"
          class="group rounded-[20px] border border-slate-200 bg-white p-4 transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md"
        >
          <div class="flex items-start justify-between gap-3">
            <span
              class="flex h-8 w-8 items-center justify-center rounded-xl bg-slate-100 text-[10px] font-black text-slate-700"
            >
              02
            </span>

            <span
              class="h-2 w-2 rounded-full"
              [ngClass]="{
                'bg-emerald-400': layers[1].status === 'Verified',
                'bg-amber-400':
                  layers[1].status === 'Waiting' ||
                  layers[1].status === 'Not verified' ||
                  layers[1].status === 'Degraded',
                'bg-rose-400': layers[1].status === 'Failed' || layers[1].status === 'Error',
                'bg-blue-400':
                  layers[1].status !== 'Verified' &&
                  layers[1].status !== 'Waiting' &&
                  layers[1].status !== 'Not verified' &&
                  layers[1].status !== 'Degraded' &&
                  layers[1].status !== 'Failed' &&
                  layers[1].status !== 'Error',
              }"
            ></span>
          </div>

          <p class="mt-4 text-[9px] font-black uppercase tracking-[0.14em] text-slate-400">
            Layer 2
          </p>

          <h3 class="mt-1 text-sm font-black text-slate-950">Office Mirror</h3>

          <p class="mt-1 text-[10px] font-medium leading-4 text-slate-500">
            Verified local mirror protection
