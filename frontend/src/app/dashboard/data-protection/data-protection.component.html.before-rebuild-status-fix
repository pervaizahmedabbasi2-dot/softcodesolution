        <div class="grid gap-3 md:grid-cols-3">
          <article class="rounded-2xl border border-emerald-200 bg-emerald-50/60 p-4">
            <div class="flex items-center justify-between gap-3">
              <div
                class="flex h-9 w-9 items-center justify-center rounded-xl bg-white text-sm font-black text-emerald-600 shadow-sm"
              >
                ✓
              </div>

              <span
                class="rounded-full border border-emerald-200 bg-white px-2.5 py-1 text-[8px] font-black uppercase tracking-wider text-emerald-700"
              >
                Connected
              </span>
            </div>

            <h4 class="mt-4 text-sm font-black text-slate-950">Restore</h4>

            <p class="mt-1 text-[9px] font-semibold leading-4 text-slate-500">
