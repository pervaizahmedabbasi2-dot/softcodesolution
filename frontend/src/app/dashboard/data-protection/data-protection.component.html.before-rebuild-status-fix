                    </div>

                    <div class="rounded-xl border border-slate-100 bg-slate-50 p-3">
                      <p class="text-[7px] font-black uppercase tracking-wider text-slate-400">
                        Offsite
                      </p>

                      <p
                        class="mt-1 text-[9px] font-black"
